generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── ENUMS ────────────────────────────────────────────────────────────────────

enum Tier {
  STANDARD
  PREMIUM
  ELITE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_DESIGN
  AWAITING_APPROVAL
  APPROVED
  BALANCE_PAID
  PRINTING
  COMPLETE
  CANCELLED
}

enum DesignCategory {
  CAKE_TOPPER
  BRIDAL_GIFT
  GUEST_FAVOR
  FRIDGE_MAGNET
}

enum GenerationMethod {
  AI_PHOTO
  DB_TEMPLATE
  EINSTAR_SCAN
}

enum DesignStatus {
  QUEUED
  GENERATING
  REVIEW
  CLIENT_SENT
  APPROVED
  REJECTED
  PRINT_READY
  FAILED
}

enum PrinterType {
  BAMBU_X1C
  BAMBU_P1S
  CREATBOT
}

enum PrintJobStatus {
  QUEUED
  PRINTING
  DONE
  FAILED
}

enum StyleTier {
  FUN
  ELEGANT
  ROMANTIC
  ADVENTUROUS
  CUSTOM
}

enum ColorTier {
  CLASSIC
  DUO
  SIGNATURE
  HEIRLOOM
}

enum AddOnType {
  HAND_PAINTING
  GIFT_BOX
  ENGRAVED_BASE
  RUSH_ORDER
  STL_LICENSE
  REORDER_FEE
  TRAVEL_FEE
  RESIN_COAT
}

// ── PHASE 2: PARTNER ENUMS ───────────────────────────────────────────────────

/// Lifecycle of a partner account. New applications land in PENDING_APPROVAL.
enum PartnerStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REJECTED
}

/// Subscription tier. Phase 2 onboards STARTER only (free, manual approval).
enum PartnerPlan {
  STARTER
  PROFESSIONAL
  STUDIO
  ENTERPRISE
}

/// Ledger entry type. COMMISSION credits, WITHDRAWAL/ADJUSTMENT can debit.
enum CreditTxnType {
  COMMISSION
  ADJUSTMENT
  WITHDRAWAL
}

/// Invoice lifecycle — unused in Phase 2, present so Phase 3 needs no migration.
enum PartnerInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
}

// ── TABLES ───────────────────────────────────────────────────────────────────

model Couple {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  phone           String?
  magicLinkToken  String?
  tokenExpiry     DateTime?
  tier            Tier      @default(STANDARD)
  createdAt       DateTime  @default(now())

  orders          Order[]
}

model Order {
  id                  String      @id @default(cuid())
  coupleId            String
  status              OrderStatus @default(PENDING_PAYMENT)
  /// Stripe PaymentIntent id for the deposit charge (used for refunds).
  paymentIntentId     String?     @map("stripePaymentId")
  stripeSessionId     String?
  depositCents        Int         @default(0)
  balanceCents        Int         @default(0)
  weddingDate         DateTime?
  colorPalette        String?
  styleNotes          String?
  styleTier           StyleTier   @default(ELEGANT)
  colorTier           ColorTier   @default(CLASSIC)
  createdAt           DateTime    @default(now())
  /// When the order was cancelled (customer or operator).
  cancelledAt         DateTime?
  /// Free-text reason (required for operator; optional for customer self-serve).
  cancellationReason  String?
  /// Actual amount refunded via Stripe, in cents (0 if none).
  refundAmountCents   Int?
  /// "customer" | "operator"
  cancelledBy         String?
  /// Operator-uploaded cleaned STL public URL (Supabase stl-files; denormalized with Design.stlUrl).
  stlFileUrl          String? @map("cleanedStlUrl")

  /// PHASE 2 — referring partner, resolved from the ?ref= slug at checkout. Null = direct order.
  partnerId           String?

  couple              Couple      @relation(fields: [coupleId], references: [id])
  designs             Design[]
  addOns              AddOn[]
  partner             Partner?    @relation(fields: [partnerId], references: [id])
  creditTransactions  CreditTransaction[]

  @@index([partnerId])
}

model Design {
  id                String           @id @default(cuid())
  orderId           String
  category          DesignCategory
  quantity          Int              @default(1)
  generationMethod  GenerationMethod @default(AI_PHOTO)
  styleTemplateId   String?
  meshyJobId        String?
  status            DesignStatus     @default(QUEUED)
  rawMeshUrl        String?
  cleanedMeshUrl    String?
  stlUrl            String?
  previewImageUrl   String?
  approvalToken     String?          @unique
  tokenExpiry       DateTime?
  revisionRound     Int              @default(1)
  clientNotes       String?
  approvedAt        DateTime?
  createdAt         DateTime         @default(now())

  order             Order            @relation(fields: [orderId], references: [id])
  styleTemplate     StyleTemplate?   @relation(fields: [styleTemplateId], references: [id])
  printJobs         PrintJob[]

  // Photo URLs stored as JSON object
  photoUrls         Json?
  partner1Name      String?
  partner2Name      String?
}

model PrintJob {
  id              String         @id @default(cuid())
  designId        String
  printer         PrinterType
  material        String
  layerHeightMm   Float
  nozzleMm        Float
  estimatedMins   Int
  supportStrategy String?
  status          PrintJobStatus @default(QUEUED)
  queuedAt        DateTime       @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  notes           String?

  design          Design         @relation(fields: [designId], references: [id])
}

model StyleTemplate {
  id              String         @id @default(cuid())
  name            String
  category        DesignCategory
  styleTier       StyleTier
  themeTag        String
  silhouetteType  String?
  baseStlUrl      String?
  previewImageUrl String?
  timesUsed       Int            @default(0)
  avgRating       Float          @default(0)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())

  designs         Design[]
}

model AddOn {
  id          String    @id @default(cuid())
  orderId     String
  type        AddOnType
  priceCents  Int
  quantity    Int       @default(1)
  notes       String?

  order       Order     @relation(fields: [orderId], references: [id])
}

/// Customer-submitted testimonials (Share your moment). Shown publicly only when approved.
model Review {
  id           String    @id @default(cuid())
  coupleName   String
  rating       Int
  comment      String
  /// Photo: wedding / couple with cake topper
  photoUrl     String?
  /// Photo: cake with topper on display
  cakePhotoUrl String?
  weddingDate  DateTime?
  approved     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@map("reviews")
}

// ── PHASE 2: PARTNER TABLES ──────────────────────────────────────────────────

/// A reseller: wedding photographer, planner, or bridal boutique.
model Partner {
  id              String        @id @default(cuid())
  /// Public-facing business name shown in the partner dashboard.
  businessName    String
  /// URL-safe identifier used in referral links: wedprint3d.com/?ref=<slug>
  slug            String        @unique
  contactName     String
  /// Login identity — matches User.email so the magic-link session resolves the partner.
  email           String        @unique
  phone           String?
  website         String?
  /// Free text from the application form ("how did you hear about us").
  referralSource  String?
  /// Operator-only notes (rejection reason, call summary, etc).
  internalNotes   String?
  status          PartnerStatus @default(PENDING_APPROVAL)
  planKey         PartnerPlan   @default(STARTER)
  /// Commission in basis points. 800 = 8.00%. Integer avoids float rounding on money.
  commissionBps   Int           @default(800)
  /// Denormalized running balance in cents — kept in sync with the CreditTransaction ledger.
  creditBalanceCents Int        @default(0)
  /// Optional link to the Auth.js User row (set on first login).
  ownerId         String?       @unique
  approvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  owner           User?              @relation(fields: [ownerId], references: [id])
  orders          Order[]
  customers       PartnerCustomer[]
  creditTransactions CreditTransaction[]
  invoices        PartnerInvoice[]

  @@index([status])
}

/// Every end customer a partner has referred. One row per (partner, email).
model PartnerCustomer {
  id            String   @id @default(cuid())
  partnerId     String
  email         String
  name          String?
  /// Attribution channel — "referral_link" today; "manual" / "api" later.
  source        String   @default("referral_link")
  firstOrderAt  DateTime?
  createdAt     DateTime @default(now())

  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, email])
  @@index([partnerId])
}

/// Append-only commission ledger. Positive = credit to partner, negative = debit.
model CreditTransaction {
  id          String        @id @default(cuid())
  partnerId   String
  /// Set for COMMISSION rows; null for manual adjustments and withdrawals.
  orderId     String?
  amountCents Int
  type        CreditTxnType
  note        String?
  createdAt   DateTime      @default(now())

  partner     Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  order       Order?        @relation(fields: [orderId], references: [id])

  /// Idempotency guard — an order can only ever accrue one COMMISSION row.
  @@unique([orderId, type])
  @@index([partnerId])
}

/// Subscription billing — scaffolded for Phase 3, unused in Phase 2.
model PartnerInvoice {
  id              String               @id @default(cuid())
  partnerId       String
  periodStart     DateTime
  periodEnd       DateTime
  amountCents     Int
  status          PartnerInvoiceStatus @default(DRAFT)
  stripeInvoiceId String?
  createdAt       DateTime             @default(now())

  partner         Partner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

// NextAuth required tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("couple")
  passwordHash  String?

  accounts      Account[]
  sessions      Session[]
  /// PHASE 2 — set when a partner account is linked to this login.
  partner       Partner?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
